{
  "name": "@double-coding/dsh-connectors",
  "version": "0.1.0",
  "description": "DeepSeek Harness MCP connector panel: browse a connector catalog, connect MCP servers, manage credentials, and import mcpServers JSON.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "mcp",
    "connectors",
    "plugins"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/double-coding-lab/dsh-connectors.git"
  },
  "homepage": "https://github.com/double-coding-lab/dsh-connectors#readme",
  "bugs": {
    "url": "https://github.com/double-coding-lab/dsh-connectors/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "providers",
    "schema",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CONTRIBUTING.en.md",
    "assets/readme"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "providers:icons": "node scripts/build-provider-icons.mjs",
    "cli:icons": "node scripts/build-cli-icons.mjs",
    "providers:check": "node scripts/check-providers.mjs",
    "provider:new": "node scripts/new-provider.mjs",
    "test:instance": "node scripts/test-instance-url.mjs",
    "test:provider-schema": "node scripts/test-provider-schema.mjs",
    "test:custom": "node scripts/test-custom-metadata.mjs",
    "test:cli": "node scripts/test-cli-adapters.mjs && node scripts/test-cli-service.mjs",
    "build": "node scripts/build-provider-icons.mjs && node scripts/build-cli-icons.mjs && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "node scripts/build-provider-icons.mjs && node scripts/build-cli-icons.mjs && tsc --noEmit && tsc -p tsconfig.client.json",
    "check": "npm run typecheck && npm run build && npm run providers:check && npm run test:instance && npm run test:provider-schema && npm run test:oauth && npm run test:custom && npm run test:cli && npm run test:sse",
    "link:web": "npm run build && dsh plugin --profile web add link:.",
    "test:oauth": "node scripts/test-oauth-discovery.mjs",
    "test:sse": "node scripts/test-sse-bridge.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "monaco-editor": "^0.57.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-storage-domain": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.2"
  }
}
